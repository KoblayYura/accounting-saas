# Локальна розробка (Docker, docker-compose.yml з цієї ж директорії)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accounting?schema=public"

# Приклад для хмарного Postgres (Neon/Supabase/Railway) — замініть на реальний рядок з панелі провайдера
# DATABASE_URL="postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require"

# --- Auth (Module 01) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
APP_BASE_URL=http://localhost:3000
PORT=4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Accounting <you@gmail.com>

